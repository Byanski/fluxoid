{
	auto_https off
	admin off
}
:48763 {
	handle /_caddy_health {
		respond "OK" 200
	}
	@options method OPTIONS
	handle @options {
		header Access-Control-Allow-Origin *
		header Access-Control-Allow-Methods *
		header Access-Control-Allow-Headers *
		respond 204
	}
	@gateway path /gateway /gateway/*
	handle @gateway {
		reverse_proxy https://gateway.fluxer.app {
			header_up Host gateway.fluxer.app
			header_up Origin https://gateway.fluxer.app
			header_up X-Forwarded-Proto https
			header_up Connection {http.request.header.Connection}
			header_up Upgrade {http.request.header.Upgrade}
		}
	}
	@marketing path /marketing /marketing/*
	handle @marketing {
		uri strip_prefix /marketing
		reverse_proxy 127.0.0.1:49531
	}
	handle /.well-known/fluxer {
		reverse_proxy 127.0.0.1:49319
	}
     	@server path /admin /admin/* /api /api/* /s3 /s3/* /queue /queue/* /media /media/* /_health /_ready /_live
    handle @server {
	    reverse_proxy https://web.fluxer.app {
		    header_up Host web.fluxer.app
		    header_up Origin https://web.fluxer.app
		    header_up Referer https://web.fluxer.app
		    header_up X-Forwarded-Proto https
		    header_down -Access-Control-Allow-Origin
	    }
	    header Access-Control-Allow-Origin *
	    header Access-Control-Allow-Methods *
	    header Access-Control-Allow-Headers *
    }
	@livekit path /livekit /livekit/*
	handle @livekit {
		uri strip_prefix /livekit
		reverse_proxy 127.0.0.1:7880
	}
	redir /mailpit /mailpit/
	handle_path /mailpit/* {
		rewrite * /mailpit{path}
		reverse_proxy 127.0.0.1:49667
	}
    handle {
		root * /home/supremegooper/fluxer/fluxer_app/dist
		try_files {path} /index.html
		file_server
	}
	log {
		output stdout
		format console
	}
}
